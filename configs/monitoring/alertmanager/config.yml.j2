global:
  resolve_timeout: 5m

route:
  receiver: 'critical-receiver'
  group_by: ['alertname', 'alerttype', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

  routes:
    # Storage alerts → storage topic
    - matchers:
        - alerttype = storage
      receiver: 'storage-receiver'
      continue: false

    # Infrastructure warnings (non-critical) → services topic
    - matchers:
        - severity = warning
        - alerttype = infrastructure
      receiver: 'services-receiver'
      continue: false

    # Everything critical → critical topic
    - matchers:
        - severity = critical
      receiver: 'critical-receiver'
      continue: false

receivers:
  - name: 'critical-receiver'
    webhook_configs:
      - url: 'http://10.1.0.24:8080/homelab-critical'
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: '{{ ntfy_alertmanager_password }}'

  - name: 'storage-receiver'
    webhook_configs:
      - url: 'http://10.1.0.24:8080/homelab-storage'
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: '{{ ntfy_alertmanager_password }}'

  - name: 'services-receiver'
    webhook_configs:
      - url: 'http://10.1.0.24:8080/homelab-services'
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password: '{{ ntfy_alertmanager_password }}'

inhibit_rules:
  # Suppress target missing warnings when node is already down
  - source_matchers:
      - alertname = NodeDown
    target_matchers:
      - alertname = PrometheusTargetMissing
    equal: ['instance']

  # Suppress service alerts when the node hosting them is down
  - source_matchers:
      - severity = critical
      - alerttype = infrastructure
    target_matchers:
      - alerttype = service
    equal: ['instance']
