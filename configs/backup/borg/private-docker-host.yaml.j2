source_directories:
  - /var/lib/docker/volumes/root_vaultwarden-data/_data
  - /var/lib/docker/volumes/root_prowlarr-config/_data
  - /var/lib/docker/volumes/root_sonarr-config/_data
  - /var/lib/docker/volumes/root_radarr-config/_data
  - /var/lib/docker/volumes/root_bazarr-config/_data
  - /var/lib/docker/volumes/root_qbittorrent-config/_data
  - /var/lib/docker/volumes/root_ghostfolio_db/_data
  - /var/lib/docker/volumes/root_kimai_db/_data
  - /var/lib/docker/volumes/root_kimai_data/_data
  - /var/lib/docker/volumes/root_kimai_plugins/_data
  - /var/lib/docker/volumes/root_gitea-data/_data

repositories:
  - path: ssh://backup@10.0.30.13/backup/repos/private-docker-host

compression: zlib,6
ssh_command: ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no
unknown_unencrypted_repo_access_is_ok: true

keep_daily: 7
keep_weekly: 4
keep_monthly: 6
keep_yearly: 2
archive_name_format: "{hostname}-{now}"
match_archives: "{hostname}-*"

checks:
  - name: repository
  - name: archives
check_last: 3

before_backup:
  - cd /root && docker compose stop vaultwarden
  - cd /root && docker compose stop prowlarr sonarr radarr bazarr qbittorrent
  - cd /root && docker compose stop ghostfolio_db ghostfolio_app ghostfolio_redis
  - cd /root && docker compose stop kimai_db kimai_app
  - cd /root && docker compose stop gitea
after_backup:
  - cd /root && docker compose start vaultwarden
  - cd /root && docker compose start prowlarr sonarr radarr bazarr qbittorrent
  - cd /root && docker compose start ghostfolio_db ghostfolio_app ghostfolio_redis
  - cd /root && docker compose start kimai_db kimai_app
  - cd /root && docker compose start gitea
on_error:
  - cd /root && docker compose start vaultwarden
  - cd /root && docker compose start prowlarr sonarr radarr bazarr qbittorrent
  - cd /root && docker compose start ghostfolio_db ghostfolio_app ghostfolio_redis
  - cd /root && docker compose start kimai_db kimai_app
  - cd /root && docker compose start gitea

loki:
  url: http://10.0.50.4:3100/loki/api/v1/push
  labels:
    app: borgmatic
    host: private-docker-host

ntfy:
  topic: homelab-critical
  server: http://10.0.40.24:8080
  username: alertmanager
  password: "{{ ntfy_alertmanager_password }}"
  fail:
    title: "borgmatic backup failed on private-docker-host"
    message: "Check borgmatic on private-docker-host - see /etc/borgmatic/config.yaml and journal/output for details"
    tags: borgmatic,backup,warning
    priority: high
  states:
    - fail
