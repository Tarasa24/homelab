source_directories:
  - /opt/technitium-dns/config
  - /opt/technitium-dns/wwwroot
  - /opt/technitium-dns/logs

repositories:
  - path: ssh://backup@10.0.30.13/backup/repos/dns

compression: zlib,6
ssh_command: ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no
unknown_unencrypted_repo_access_is_ok: true

keep_daily: 7
keep_weekly: 4
keep_monthly: 6
keep_yearly: 2
archive_name_format: "{hostname}-{now}"
match_archives: "{hostname}-*"

checks:
  - name: repository
  - name: archives
check_last: 3

before_backup:
  - rc-service technitium-dns stop
after_backup:
  - rc-service technitium-dns start
on_error:
  - rc-service technitium-dns start

loki:
  url: http://10.0.50.4:3100/loki/api/v1/push
  labels:
    app: borgmatic
    host: dns

ntfy:
  topic: homelab-critical
  server: http://10.0.40.24:8080
  username: alertmanager
  password: "{{ ntfy_alertmanager_password }}"
  fail:
    title: "borgmatic backup failed on dns"
    message: "Check borgmatic on dns - see /etc/borgmatic/config.yaml and journal/output for details"
    tags: borgmatic,backup,warning
    priority: high
  states:
    - fail
