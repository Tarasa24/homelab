source_directories:
  - /etc/letsencrypt

repositories:
  # At cutover the repo directory is renamed from dmz-router to dmz-proxy AND
  # every archive inside it must be renamed too, with `borg rename` per archive
  # -- moving the directory alone is not enough. archive_name_format below is
  # keyed on {hostname}, so `borgmatic extract --archive latest` resolves
  # "latest" only within match_archives (dmz-proxy-*) and cannot see archives
  # still called dmz-router-*. The borgmatic role treats "No archives found" as
  # success, so a missed rename does not fail the play: the container just comes
  # up with nothing restored. See the runbook in the PR description.
  - path: ssh://backup@10.0.30.13/backup/repos/dmz-proxy

compression: zlib,6
ssh_command: ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no
unknown_unencrypted_repo_access_is_ok: true

keep_daily: 7
keep_weekly: 4
keep_monthly: 6
keep_yearly: 2
archive_name_format: "{hostname}-{now}"
match_archives: "{hostname}-*"

checks:
  - name: repository
  - name: archives
check_last: 3

loki:
  url: http://10.0.50.4:3100/loki/api/v1/push
  labels:
    app: borgmatic
    host: dmz-proxy

ntfy:
  topic: homelab-critical
  server: http://10.0.40.24:8080
  username: alertmanager
  password: "{{ ntfy_alertmanager_password }}"
  fail:
    title: "borgmatic backup failed on dmz-proxy"
    message: "Check borgmatic on dmz-proxy - see /etc/borgmatic/config.yaml and journal/output for details"
    tags: borgmatic,backup,warning
    priority: high
  states:
    - fail
