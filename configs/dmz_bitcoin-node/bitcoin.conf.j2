# Enable full transaction relay
server=1
listen=1
txindex=1

# Enable incoming connections
bind=0.0.0.0:8333
externalip={{ wan_public_ip }}

# Disable pruning to act as a full node
prune=0

# Upstream default; was 200. Per-peer buffers are memory this 2048 MB
# container (shared with electrs) does not have.
maxconnections=125

# RPC Configuration
rpcbind=127.0.0.1
rpcallowip=127.0.0.1

# Other performance tuning
assumevalid=0

# Was 2560: a 2.5 GB cache target inside a 2048 MB cgroup, worth ~648k
# memory.high events. Lowering it trades RAM for random reads on a USB
# disk, so check /proc/pressure/io before going below this.
dbcache=300

# Default 300; halved, mempool is resident.
maxmempool=150
disablewallet=1
